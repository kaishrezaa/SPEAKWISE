# SpeakWise Server Environment Variables

# ============================================================
# GNANI AI CREDENTIALS (Required for speech features)
# ============================================================
GNANI_API_KEY=your_gnani_api_key_here

# ============================================================
# GEMINI AI EVALUATION (Google GenAI)
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# Medium Tier Model (for detailed analysis & articulation improvement)
GEMINI_MEDIUM_MODEL=gemini-2.5-flash

# Light Tier Model (for lightweight / fast analysis)
GEMINI_LIGHT_MODEL=gemini-2.5-flash-lite

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3001
FRONTEND_URL=http://localhost:5173

# ============================================================
# GNANI API CONFIGURATION
# ============================================================
GNANI_STT_BASE_URL=https://api.vachana.ai
GNANI_TTS_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_LANGUAGE=en-IN
GNANI_TTS_DEFAULT_VOICE=Shivani
